#!/usr/bin/env bash
# Pull-based deploy of darkmatterits.com. Runs as root from deploy-darkmatterits.timer.
#
#   deploy-darkmatterits              deploy the newest main once its CI run on GitHub has passed
#   deploy-darkmatterits --now        deploy the newest main now, without waiting for CI
#   deploy-darkmatterits --now SHA    deploy SHA (must be on main) and hold it until main moves (rollback)
#
# Why pull: the repo is public, so nothing GitHub runs (forks, branches, PRs) may have a path onto
# the Pi. Root fetches main itself over HTTPS (no credentials), so the only code that can deploy is
# what is on GitHub's main. No runner, no sudo rule, nothing in the Actions logs.
#
# Before anything is built: the commit may not contain symlinks or submodules; its .gitattributes
# can't alter the export; docker-compose.yml (and the Dockerfiles it builds) must pass the
# root-owned allowlist (darkmatterits-compose-check, under `timeout 60`, BEFORE compose reads it)
# and then compose-guard; mailer/Dockerfile (the only Dockerfile compose builds) must be
# byte-identical to the approved copy install.sh put on the Pi (deploy-darkmatterits-dockerfile-check,
# D3-fix2). Files are copied with fixed modes (no setuid, nothing world-writable).
# mailer/.env and the folder's .git are kept. Right before `docker compose up`,
# deploy-darkmatterits-preup-check refuses symlinks in the folder, a root .env, or a
# docker-compose.yml that differs from the checked copy, and the approved-Dockerfile check runs
# again on the live folder.
set -Eeuo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export GIT_TERMINAL_PROMPT=0 HOME=/root
umask 022

REPO=KingZCoding/darkMatterIT
REPO_URL=https://github.com/$REPO.git
API=https://api.github.com/repos/$REPO
WORKFLOW_PATH=.github/workflows/check.yml
STATE=/var/lib/deploy-darkmatterits
GIT_DIR=$STATE/repo.git
STAGE=$STATE/stage
DEST=/data/sites/newsite
PROJECT=newsite
# The one approved mailer Dockerfile (D3-fix2, Cody 2026-11-13 "Exact-match approved copy").
# Installed root-owned (644) by install.sh; in /usr/local/sbin so secwatch's existing watch on
# /usr/local/sbin/* reports any change made outside install.sh. A constant on purpose: nothing
# (environment, systemd unit, the commit) can point the deploy at another file.
APPROVED_DOCKERFILE=/usr/local/sbin/darkmatterits-mailer.Dockerfile
COMPOSE=(docker compose --project-directory "$DEST" --project-name "$PROJECT" -f "$DEST/docker-compose.yml")

sha=
log() { echo "$*"; logger -t deploy-darkmatterits -- "$*"; }
# A deploy failure is sticky for that commit: the timer won't rebuild it every 5 minutes.
# A failed `--now` also drops any rollback pin: the folder may be half-applied, so the timer must
# be free to put main back (main itself is skipped only if it is the commit that just failed).
fail() {
  trap - ERR
  log "FAILED ${sha:0:12}: $*"
  if [ -n "$sha" ]; then echo "$sha" > "$STATE/failed"; fi
  if [ "$now" = 1 ]; then rm -f "$STATE/pinned"; fi
  exit 1
}

now=0; want=; pin_to=
case "${1:-}" in
  --now) now=1; want=${2:-} ;;
  "") ;;
  *) echo "usage: deploy-darkmatterits [--now [SHA]]" >&2; exit 2 ;;
esac
[ "$(id -u)" = 0 ] || { echo "run as root" >&2; exit 1; }
[ -f "$DEST/mailer/.env" ] || { log "No $DEST/mailer/.env; create it once by hand (see DEPLOY.md)"; exit 1; }

install -d -m 700 -o root -g root "$STATE"
exec 9>/run/deploy-darkmatterits.lock
if [ "$now" = 1 ]; then
  echo "waiting for any running deploy to finish..."; flock 9
else
  flock -n 9 || exit 0   # a deploy is already running; the next tick will look again
fi

# --- Fetch main (network errors: just try again next tick) -----------------------------------
[ -d "$GIT_DIR" ] || git init -q --bare "$GIT_DIR"
# Neutralise the commit's own .gitattributes for `git archive`: no export-subst (it would let a
# commit message or branch name be written into files), no export-ignore, no filters.
printf '* -export-subst -export-ignore -ident -filter -working-tree-encoding\n' > "$GIT_DIR/info/attributes"
if ! git --git-dir="$GIT_DIR" -c transfer.fsckObjects=true fetch -q --no-tags --prune "$REPO_URL" '+refs/heads/main:refs/heads/main'; then
  echo "fetch failed; will retry"; exit 0
fi
main=$(git --git-dir="$GIT_DIR" rev-parse --verify -q 'refs/heads/main^{commit}')

if [ "$now" = 1 ]; then
  if [ -n "$want" ]; then
    sha=$(git --git-dir="$GIT_DIR" rev-parse --verify -q "$want^{commit}") || { echo "unknown commit $want" >&2; exit 2; }
    git --git-dir="$GIT_DIR" merge-base --is-ancestor "$sha" "$main" || { echo "$want is not on main" >&2; exit 2; }
  else
    sha=$main
  fi
  # A rollback holds until main moves past the commit it was taken on. The pin is written only
  # after the deploy succeeds (bottom of this file), so a failed rollback never holds.
  if [ "$sha" != "$main" ]; then pin_to=$main; fi
else
  sha=$main
  if [ -f "$STATE/pinned" ]; then
    [ "$main" = "$(cat "$STATE/pinned")" ] && exit 0                 # rolled back; main hasn't moved
    rm -f "$STATE/pinned"; log "main moved past the rollback pin; resuming normal deploys"
  fi
  [ "$sha" = "$(cat "$STATE/deployed" 2>/dev/null || true)" ] && exit 0   # already live
  [ "$sha" = "$(cat "$STATE/failed" 2>/dev/null || true)" ] && exit 0     # failed to deploy; needs a new commit or --now

  # --- Wait for the push-to-main run of this repo's own check workflow on this exact commit ---
  # Only runs GitHub itself started for a push to main of this repo, from check.yml, count; a check
  # run posted by some other workflow or app can't make the Pi deploy.
  verdict=$(curl -fsS --max-time 20 -H 'Accept: application/vnd.github+json' \
      "$API/actions/runs?head_sha=$sha&event=push&branch=main&per_page=20" | \
    REPO="$REPO" WORKFLOW_PATH="$WORKFLOW_PATH" python3 -I -c '
import json, os, sys
runs = [r for r in json.load(sys.stdin).get("workflow_runs", [])
        if r.get("path") == os.environ["WORKFLOW_PATH"]
        and (r.get("repository") or {}).get("full_name") == os.environ["REPO"]
        and (r.get("head_repository") or {}).get("full_name") == os.environ["REPO"]
        and r.get("event") == "push" and r.get("head_branch") == "main"]
runs.sort(key=lambda r: (r.get("run_number", 0), r.get("run_attempt", 0)), reverse=True)
latest = runs[0] if runs else None
if latest is None or latest.get("status") != "completed": print("pending")
elif latest.get("conclusion") == "success": print("success")
elif latest.get("conclusion") == "failure": print("failure")
else: print("pending")   # cancelled / skipped / timed out: wait for a re-run') \
    || { echo "could not read CI status for ${sha:0:12}; will retry"; exit 0; }
  case "$verdict" in
    success) ;;
    pending) exit 0 ;;
    *)
      # Not sticky: a re-run that passes is picked up on a later tick. Log once per commit.
      if [ "$sha" != "$(cat "$STATE/ci_failed" 2>/dev/null || true)" ]; then
        log "CI failed for ${sha:0:12}; not deploying"; echo "$sha" > "$STATE/ci_failed"
      fi
      exit 0 ;;
  esac
fi

# From here on any unexpected error is a logged, sticky failure for this commit.
trap 'fail "unexpected error at line $LINENO"' ERR

log "deploying ${sha:0:12} $(git --git-dir="$GIT_DIR" log -1 --format=%s "$sha" | cut -c1-80)"

# --- Stage a root-only copy of exactly that commit ------------------------------------------
if git --git-dir="$GIT_DIR" ls-tree -r "$sha" | awk '$1 == "120000" || $1 == "160000" {f=1} END {exit !f}'; then
  fail "commit contains symlinks or submodules"
fi
rm -rf "$STAGE"
install -d -m 700 -o root -g root "$STAGE"
git --git-dir="$GIT_DIR" archive --format=tar "$sha" | tar -x -C "$STAGE" --no-same-owner --no-same-permissions
[ -f "$STAGE/docker-compose.yml" ] || fail "no docker-compose.yml in the commit"

# --- Check the compose file is safe to run as root ------------------------------------------
# 1) Strict allowlist on the parsed file, before docker compose reads it at all.
#    `timeout 60`: a file that makes the parser hang becomes a recorded failure, not a 20-minute
#    root process repeated every tick.
timeout 60 darkmatterits-compose-check "$STAGE/docker-compose.yml" || fail "compose allowlist refused the file (or timed out)"
# 2) The Pi-wide guard on the resolved config.
docker compose --project-directory "$DEST" --project-name "$PROJECT" -f "$STAGE/docker-compose.yml" \
  config --format json | compose-guard "$DEST" "$STAGE/docker-compose.yml" || fail "compose-guard refused"
# 3) The Dockerfile compose will build must be the approved copy, byte for byte. The allowlist
#    above is only a denylist for Dockerfile tricks; this is the gate that does not depend on
#    parsing Dockerfiles the way BuildKit does (D3-fix2). Message tells Cody how to approve.
deploy-darkmatterits-dockerfile-check "$STAGE" "$APPROVED_DOCKERFILE" \
  || fail "mailer/Dockerfile differs from the approved copy on the Pi; re-run the Pi install from this commit to approve it"

# --- Copy into place with fixed modes, then rebuild -----------------------------------------
# --perms with --chmod=D755,F644 sets exact modes on every file (clears setuid/setgid/sticky and
# any group/world write); --chown makes it all admin's, like the other site folders.
rsync -rt --perms --chmod=D755,F644 --chown=admin:admin --delete --no-links --no-specials --no-devices \
  --exclude /.git --exclude .env -- "$STAGE/" "$DEST/"

# Last look at DEST right before compose reads it: no symlinks, no root .env, and the compose
# file is the one that was checked (see deploy-darkmatterits-preup-check for why).
deploy-darkmatterits-preup-check "$STAGE" "$DEST" || fail "pre-up check refused the project folder"
# And the Dockerfile compose is about to read in DEST is still the approved one (same reason as
# the compose-file comparison in the pre-up check: nothing may change it after the check).
deploy-darkmatterits-dockerfile-check "$DEST" "$APPROVED_DOCKERFILE" \
  || fail "mailer/Dockerfile in $DEST is not the approved copy right before compose up"

# --force-recreate: the site's config and web root are bind mounts and rsync replaces files
# (new inodes), so the site container must be recreated to see them.
"${COMPOSE[@]}" up -d --build --force-recreate --remove-orphans || fail "docker compose up failed"

# --- Health check -----------------------------------------------------------------------------
mailer_id=$("${COMPOSE[@]}" ps -q darkmatter-mailer)
for _ in $(seq 1 18); do
  [ "$(docker inspect -f '{{.State.Health.Status}}' "$mailer_id" 2>/dev/null || true)" = healthy ] && break
  sleep 5
done
bad=$("${COMPOSE[@]}" ps -a --status exited --status restarting --services)
for id in $("${COMPOSE[@]}" ps -q); do
  if [ "$(docker inspect -f '{{.RestartCount}}' "$id")" != 0 ]; then
    bad="$bad $(docker inspect -f '{{index .Config.Labels "com.docker.compose.service"}}' "$id")"
  fi
done
if [ "$(docker inspect -f '{{.State.Health.Status}}' "$mailer_id" 2>/dev/null || true)" != healthy ]; then
  bad="$bad darkmatter-mailer(unhealthy)"
fi
bad=$(echo $bad)
if [ -n "$bad" ]; then
  # Logs go to the journal only (root/adm): they contain visitor IPs.
  for s in darkmatter-site darkmatter-mailer; do
    "${COMPOSE[@]}" logs --tail 40 "$s" 2>&1 | logger -t deploy-darkmatterits || true
  done
  fail "not healthy after deploy: $bad (container logs: journalctl -t deploy-darkmatterits)"
fi
curl -fsS -o /dev/null --max-time 10 http://10.50.0.3:8085/ || fail "site did not answer on 10.50.0.3:8085"

trap - ERR
echo "$sha" > "$STATE/deployed"
rm -f "$STATE/failed" "$STATE/ci_failed"
# Rollback pin, only now that the deploy is good: `--now <older sha>` holds until main moves;
# `--now` on main itself clears any earlier pin.
if [ "$now" = 1 ]; then
  if [ -n "$pin_to" ]; then echo "$pin_to" > "$STATE/pinned"; else rm -f "$STATE/pinned"; fi
fi
# Only this project's dangling images (keeps other projects' rollback images).
docker image prune -f --filter "label=com.docker.compose.project=$PROJECT" >/dev/null || true
log "deployed ${sha:0:12}"
